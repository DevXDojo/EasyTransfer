{
  "name": "file-transfer-server",
  "version": "3.4.3",
  "description": "Server for file transfer",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsc && nodemon dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --fix",
    "format": "prettier --write src/ tests/"
  },
  "keywords": [
    "file",
    "transfer",
    "server"
  ],
  "author": "ch3nyang",
  "license": "MIT",
  "dependencies": {
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
